# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.
#exec waybar
#exec waybar -c ~/.config/waybar/config-vertical.jsonc -s ~/.config/waybar/style-vertical.css
### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term kitty
# Your preferred application launcher
set $menu wofi --show drun
set $file_explorer nautilus
exec hash dbus-update-activation-environment 2>/dev/null && \
     dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
#output * bg /home/ms/Downloads/wallpaper.jpg fill
exec /home/ms/.local/bin/mpvpaper -p -f -o "loop no-audio hwdec=auto vo=dmabuf-wayland" '*' /home/ms/Downloads/wallpaper1_1080p.mp4

#
# Example configuration:
#
#output HDMI-1 resolution 1920x1080@144.003 Hz position 1920, 0

# You can get the names of your outputs by running: swaymsg -t get_outputs

#========making the border and gaps=============== 
gaps inner 5 
gaps outer 5

default_border pixel 3
default_floating_border pixel 3

exec_always ~/.config/eww/scripts/start.sh
#==== broder colors =====

